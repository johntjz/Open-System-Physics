<!DOCTYPE html>
<html lang="en" data-lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ order | padNumber }}. {{ title }} — {% endif %}Open-System Physics</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  {% set totalNodes = collections.chapters | length %}
  <div class="progress-bar" id="progressBar"></div>

  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand">
        <span class="brand-code">[1·2·5·6]</span>
        <span class="lang-en">Open-System Physics</span>
        <span class="lang-zh">開放系統物理學 · 經方熱力學</span>
      </a>

      <div class="header-controls">
        {% if order %}
        <button type="button" class="map-toggle-btn" id="mapToggleBtn" aria-label="Toggle Puzzle Map">
          <span class="lang-en">Node {{ order | padNumber }} / {{ totalNodes | padNumber }} ▾</span>
          <span class="lang-zh">節點 {{ order | padNumber }} / {{ totalNodes | padNumber }} ▾</span>
        </button>
        {% endif %}
        <button type="button" class="lang-toggle-btn" id="langToggleBtn">
          <span class="lang-en">繁體中文</span>
          <span class="lang-zh">English</span>
        </button>
      </div>
    </div>

    {% if order %}
    <nav class="chapter-drawer" id="chapterDrawer" hidden>
      <div class="drawer-inner">
        <div class="drawer-title">
          <span class="lang-en">Complete {{ totalNodes }}-Node Logical Sequence</span>
          <span class="lang-zh">全 {{ totalNodes }} 節點完整邏輯脈絡圖</span>
        </div>
        <div class="drawer-grid">
          {% for item in collections.chapters %}
          <a href="{{ item.url }}" class="drawer-item {% if item.url == page.url %}active{% endif %}">
            <span class="drawer-num">{{ item.data.order | padNumber }}</span>
            <span class="drawer-text">
              <span class="lang-en">{{ item.data.title }}</span>
              <span class="lang-zh">{{ item.data.title_zh or item.data.title }}</span>
            </span>
          </a>
          {% endfor %}
        </div>
      </div>
    </nav>
    {% endif %}
  </header>

  <main class="container">
    {% if order %}
      {% set prevChapter = null %}
      {% set nextChapter = null %}
      {% for item in collections.chapters %}
        {% if item.data.order == (order - 1) %}
          {% set prevChapter = item %}
        {% endif %}
        {% if item.data.order == (order + 1) %}
          {% set nextChapter = item %}
        {% endif %}
      {% endfor %}

      <article class="chapter-article">
        <div class="chapter-meta">
          <span class="badge-module">
            <span class="lang-en">MODULE {{ module_num }} · {{ module }}</span>
            <span class="lang-zh">第{{ module_num }}卷 · {{ module_zh or module }}</span>
          </span>
          <span class="badge-step">
            <span class="lang-en">NODE {{ order | padNumber }} OF {{ totalNodes | padNumber }}</span>
            <span class="lang-zh">節點 {{ order | padNumber }} / {{ totalNodes | padNumber }}</span>
          </span>
        </div>

        <h1 class="chapter-title">
          <span class="lang-en">{{ title }}</span>
          <span class="lang-zh">{{ title_zh or title }}</span>
        </h1>

        {% if summary %}
        <p class="chapter-summary">
          <span class="lang-en">{{ summary }}</span>
          <span class="lang-zh">{{ summary_zh or summary }}</span>
        </p>
        {% endif %}

        <hr class="divider">

        <div class="prose lang-en">
          {{ content | langSection("en") | safe }}
        </div>

        <div class="prose lang-zh">
          {{ content | langSection("zh") | safe }}
        </div>

        <footer class="puzzle-nav">
          {% if next_logic %}
          <div class="logic-bridge">
            <div class="bridge-label">
              <span class="lang-en">⚡ LOGICAL VECTOR TO NEXT NODE</span>
              <span class="lang-zh">⚡ 通往下一節點之邏輯向量</span>
            </div>
            <p class="bridge-text">
              <span class="lang-en">{{ next_logic }}</span>
              <span class="lang-zh">{{ next_logic_zh or next_logic }}</span>
            </p>
          </div>
          {% endif %}

          <div class="nav-cards">
            {% if prevChapter %}
            <a href="{{ prevChapter.url }}" class="nav-card prev-card">
              <span class="nav-dir">
                <span class="lang-en">← PREVIOUS NODE ({{ prevChapter.data.order | padNumber }})</span>
                <span class="lang-zh">← 上一節點 ({{ prevChapter.data.order | padNumber }})</span>
              </span>
              <strong class="nav-card-title">
                <span class="lang-en">{{ prevChapter.data.title }}</span>
                <span class="lang-zh">{{ prevChapter.data.title_zh or prevChapter.data.title }}</span>
              </strong>
            </a>
            {% else %}
            <a href="/" class="nav-card prev-card">
              <span class="nav-dir">
                <span class="lang-en">← SYSTEM MATRIX</span>
                <span class="lang-zh">← 返回系統總覽</span>
              </span>
              <strong class="nav-card-title">
                <span class="lang-en">Index & Search</span>
                <span class="lang-zh">目錄與搜尋</span>
              </strong>
            </a>
            {% endif %}

            {% if nextChapter %}
            <a href="{{ nextChapter.url }}" class="nav-card next-card">
              <span class="nav-dir">
                <span class="lang-en">NEXT NODE ({{ nextChapter.data.order | padNumber }}) →</span>
                <span class="lang-zh">下一節點 ({{ nextChapter.data.order | padNumber }}) →</span>
              </span>
              <strong class="nav-card-title">
                <span class="lang-en">{{ nextChapter.data.title }}</span>
                <span class="lang-zh">{{ nextChapter.data.title_zh or nextChapter.data.title }}</span>
              </strong>
            </a>
            {% else %}
            <a href="/" class="nav-card next-card">
              <span class="nav-dir">
                <span class="lang-en">↻ LOOP COMPLETE ({{ totalNodes | padNumber }} / {{ totalNodes | padNumber }})</span>
                <span class="lang-zh">↻ 系統閉環完成 ({{ totalNodes | padNumber }} / {{ totalNodes | padNumber }})</span>
              </span>
              <strong class="nav-card-title">
                <span class="lang-en">Return to Node 01 / System Matrix</span>
                <span class="lang-zh">返回第一節點 / 系統總覽</span>
              </strong>
            </a>
            {% endif %}
          </div>
        </footer>
      </article>
    {% else %}
      {{ content | safe }}
    {% endif %}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <span>Open-System Physics · Classical Thermodynamic Architecture</span>
      <span class="version-stamp">v.2.1 · website last updated: 2026-10-22</span>
    </div>
  </footer>

  <script>
    (function() {
      const htmlEl = document.documentElement;
      const langBtn = document.getElementById('langToggleBtn');
      const mapBtn = document.getElementById('mapToggleBtn');
      const drawer = document.getElementById('chapterDrawer');
      const progressBar = document.getElementById('progressBar');

      const params = new URLSearchParams(window.location.search);
      const savedLang = params.get('lang') || localStorage.getItem('osp_lang') || (window.location.pathname.startsWith('/zh-hant') ? 'zh' : 'en');
      htmlEl.setAttribute('data-lang', savedLang);
      localStorage.setItem('osp_lang', savedLang);

      if (langBtn) {
        langBtn.addEventListener('click', () => {
          const current = htmlEl.getAttribute('data-lang') === 'zh' ? 'en' : 'zh';
          htmlEl.setAttribute('data-lang', current);
          localStorage.setItem('osp_lang', current);
        });
      }

      if (mapBtn && drawer) {
        mapBtn.addEventListener('click', () => {
          drawer.hidden = !drawer.hidden;
        });
      }

      window.addEventListener('scroll', () => {
        if (!progressBar) return;
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
        progressBar.style.width = scrolled + '%';
      }, { passive: true });
    })();
  </script>
</body>
</html>
